#include <windows.h>
#include <winver.h>

1 ICON "res/app.ico"
2 ICON "res/doc.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "MDReader.manifest"

#ifndef APP_VERSION_NUM
#define APP_VERSION_NUM 1,0,0,0
#endif
#ifndef APP_VERSION_STR
#define APP_VERSION_STR "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MDReader"
      VALUE "FileDescription", "MDReader - lightweight Markdown reader"
      VALUE "FileVersion", APP_VERSION_STR
      VALUE "ProductName", "MDReader"
      VALUE "ProductVersion", APP_VERSION_STR
      VALUE "OriginalFilename", "MDReader.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
